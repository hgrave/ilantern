# Copy to .env and fill in. ./scripts/bootstrap.sh does this for you and
# generates the secrets. Never commit the resulting .env.

# --- Admin account (used only on first install) -------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# --- Database -----------------------------------------------------------------
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

# --- Redis (file locking + caching) -------------------------------------------
REDIS_PASSWORD=

# --- Networking ---------------------------------------------------------------
# Space-separated list of hostnames the instance answers on.
NEXTCLOUD_TRUSTED_DOMAINS=localhost
# Host port for the plain-HTTP app container. Behind the tls profile, keep this
# bound to loopback or drop the mapping entirely.
NEXTCLOUD_HTTP_PORT=8080

# Set when a reverse proxy terminates TLS, so generated URLs use https://.
OVERWRITEPROTOCOL=
OVERWRITECLIURL=
# CIDR/IP of the proxy, e.g. 172.16.0.0/12 for the compose network.
TRUSTED_PROXIES=
# Set to 1 when the proxy already sets X-Forwarded-For correctly.
APACHE_DISABLE_REWRITE_IP=0

# --- TLS profile (docker compose --profile tls up -d) -------------------------
NEXTCLOUD_DOMAIN=localhost
ACME_EMAIL=

# --- PHP tuning ---------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=10G
NEXTCLOUD_DEFAULT_PHONE_REGION=US

# --- Image versions -----------------------------------------------------------
# Nextcloud only supports one major version step per upgrade; bump deliberately.
NEXTCLOUD_IMAGE_TAG=34-apache
POSTGRES_IMAGE_TAG=17-alpine
REDIS_IMAGE_TAG=8-alpine
CADDY_IMAGE_TAG=2-alpine
